; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alexandria"
config/description="2D isometric survival and village game (ported from Unity)."
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[importer_defaults]

texture={
"mipmaps/generate": true
}

[physics]

common/physics_interpolation=true

[shader_globals]

snow_cover={
"type": "float",
"value": 0.0
}

[rendering]


textures/canvas_textures/default_texture_filter=3

environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
